diff --git a/lib/src/ui/line_color_resolver.dart b/lib/src/ui/line_color_resolver.dart
new file mode 100644
--- /dev/null
+++ b/lib/src/ui/line_color_resolver.dart
@@ -0,0 +1,7 @@
+import 'dart:ui';
+import 'package:xterm/src/terminal.dart';
+
+/// Optional display-only color for a visible buffer row. Returning null keeps
+/// the theme. Explicit terminal colors and inverse cells always take priority.
+/// The callback must not modify the terminal or perform asynchronous work.
+typedef TerminalLineColorResolver = Color? Function(Terminal terminal, int row);
